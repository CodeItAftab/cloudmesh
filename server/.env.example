# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Upstash Redis (for BullMQ)
REDIS_URL="rediss://default:password@xxxx.upstash.io:6379"

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"
GOOGLE_REDIRECT_URI_SIGNIN="http://localhost:3000/auth/google/callback"
GOOGLE_REDIRECT_URI_CONNECT="http://localhost:3000/accounts/google/callback"

# Master key for encrypting stored OAuth tokens (32 bytes, base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="xxxx"

# Session cookie config
SESSION_COOKIE_NAME="app_session"
SESSION_TTL_DAYS="30"

PORT="3000"
NODE_ENV="development"